{
  "version": 6,
  "configurePresets": [
    {"name": "cpu-debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/cpu-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "FOMHD_ENABLE_CUDA": "OFF"}},
    {"name": "cpu-release", "inherits": "cpu-debug", "binaryDir": "${sourceDir}/build/cpu-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "cpu-sanitize", "inherits": "cpu-debug", "binaryDir": "${sourceDir}/build/cpu-sanitize", "cacheVariables": {"FOMHD_SANITIZERS": "ON"}},
    {"name": "cuda-release", "inherits": "cpu-release", "binaryDir": "${sourceDir}/build/cuda-release", "cacheVariables": {"FOMHD_ENABLE_CUDA": "ON"}}
  ],
  "buildPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug", "jobs": 2},
    {"name": "cpu-release", "configurePreset": "cpu-release", "jobs": 2},
    {"name": "cpu-sanitize", "configurePreset": "cpu-sanitize", "jobs": 2},
    {"name": "cuda-release", "configurePreset": "cuda-release", "jobs": 2}
  ],
  "testPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "cpu-release", "configurePreset": "cpu-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
